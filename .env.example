# NVIDIA API (server-side only). Optional; required for model-backed AI and image reading.
NVIDIA_API_KEY=
# Leave blank to use the defaults defined in api/ai.js.
NVIDIA_MODEL=
NVIDIA_BASE_URL=

# Supabase project settings. Keep the service role key server-side; never use a VITE_ prefix.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set to "server" after the Supabase schema and Storage bucket are configured.
VITE_COMMUNITY_API_URL=server
