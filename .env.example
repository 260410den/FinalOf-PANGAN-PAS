# NVIDIA API (server-side only). Optional; required for model-backed AI and image reading.
NVIDIA_API_KEY=
# Leave blank to use the defaults defined in api/ai.js.
NVIDIA_MODEL=
NVIDIA_BASE_URL=

# PHP account API. The URL must end at the backend's /api directory.
ACCOUNT_API_ORIGIN=
# Use the same random value as proxy_secret in backend-php/config.php.
ACCOUNT_PROXY_SECRET=

# Leave blank for browser-local community storage. Set to "server" only after PHP/MySQL is configured.
VITE_COMMUNITY_API_URL=
